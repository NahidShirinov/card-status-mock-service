{
  "priority": 3,
  "request": {
    "method": "POST",
    "urlPath": "/api/cards/status",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.cardId",
          "matches": ".*[05]$"
        }
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "result": "ERROR",
      "errorCode": "INTERNAL_ERROR",
      "message": "Simulated internal server error (~20% of cardIds ending in 0 or 5)"
    },
    "delayDistribution": { "type": "uniform", "lower": 50, "upper": 300 }
  }
}
